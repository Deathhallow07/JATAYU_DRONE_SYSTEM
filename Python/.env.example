# Copy to .env. Read by Back/index.js and the producer scripts.

# Relay port. The Vite dev server proxies to it (Front/vite.config.ts).
GUI_PORT=7100

# Where producers reach the relay.
GUI_URL=http://127.0.0.1:7100

# Every artifact the browser can request must resolve inside this directory.
# Point it at the pipeline's mission_logs/ tree.
MISSION_ROOT=/path/to/SIH-GUI/mission_logs

# Comma-separated browser origins. Unset = allow all (fine on a closed network).
# ALLOWED_ORIGINS=http://localhost:5273

LOG_LEVEL=info

# ─── UAV telemetry (telem_worker.py) ──────────────────────────────────────────
# Same names as the existing GCS's Python/.env so one convention covers both consoles.
# UAVn defaults to udp 127.0.0.1:(14550 + n*10).
ENABLE_UAV0=true
UAV0_PORT=14550
# UAV0_ENDPOINT=udpin:0.0.0.0:14550   # full pymavlink string, wins over the port

# ─── Front-end ────────────────────────────────────────────────────────────────
# The pipeline's annotated geolocalisation feed (DISPLAY_MODE = "stream" in
# Pipeline_yoloe_logs_robust.py serves MJPEG on STREAM_PORT).
# VITE_PIPELINE_STREAM=http://127.0.0.1:8080/
# VITE_MAPBOX_TOKEN=pk....

# ─── Launching a run from the console (Back/pipeline.js) ──────────────────────
# The GUI picks the .mp4 and the .csv; these say what to run them through.

# The pipeline itself. Not modified — Python/run_pipeline.py rewrites a copy of
# its source in memory with the chosen video, CSV and DISPLAY_MODE="stream".
PIPELINE_SCRIPT=/path/to/SIH-GUI/pipeline/Pipeline_yoloe_logs_robust.py

# Two interpreters, because no env on this machine has every import:
#   PIPELINE_PY  ultralytics + torch + onnxruntime + sklearn   (work_env)
#   GUI_PY       python-socketio + opencv                      (gcs_gui)
PIPELINE_PY=/home/dk3rox/miniconda3/envs/work_env/bin/python
GUI_PY=/home/dk3rox/miniconda3/envs/gcs_gui/bin/python

# Weights. Both are what the pipeline hardcodes at the top of the file, pointed
# at this machine. Leave a value empty to keep the pipeline's own path.
YOLOE_WEIGHTS=/path/to/SIH-GUI/pipeline/yoloe-26s-seg.pt
REID_CKPT=/path/to/SIH-GUI/pipeline/epoch_003.pth

# The pipeline's MJPEG server (DISPLAY_MODE="stream"). This is the
# Geolocalisation raw feed; the browser reads it directly, not through the
# relay. Set here ONCE: the relay passes it to the pipeline it launches and
# reports it to the browser, so the two cannot drift apart.
PIPELINE_STREAM_PORT=8080

# Only when the pipeline runs on a DIFFERENT host from the browser, where a
# port alone cannot find it. Normally leave this unset.
# PIPELINE_STREAM_URL=http://pipeline-host:8080/

# Directories the console's file picker may browse, colon-separated like PATH.
# It is a jail, not a shortcut: a path resolving outside these is refused.
MEDIA_ROOTS=/home/dk3rox/scp:/home/dk3rox/DK3ROX/Programs/Python/SIH-GUI

# Depth / traversability backends, when the run is started with workers on.
DEPTH_BACKEND=stub
SEG_BACKEND=stub
